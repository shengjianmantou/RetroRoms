{
  "name": "retroroms",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "retroroms",
      "version": "0.1.0",
      "license": "UNLICENSED",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "apps/cli": {
      "name": "@retroroms/cli",
      "version": "0.1.0",
      "dependencies": {
        "@retroroms/ingest": "0.1.0"
      }
    },
    "node_modules/@retroroms/catalog": {
      "resolved": "packages/catalog",
      "link": true
    },
    "node_modules/@retroroms/cli": {
      "resolved": "apps/cli",
      "link": true
    },
    "node_modules/@retroroms/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@retroroms/ingest": {
      "resolved": "packages/ingest",
      "link": true
    },
    "node_modules/@retroroms/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "packages/catalog": {
      "name": "@retroroms/catalog",
      "version": "0.1.0"
    },
    "packages/core": {
      "name": "@retroroms/core",
      "version": "0.1.0"
    },
    "packages/ingest": {
      "name": "@retroroms/ingest",
      "version": "0.1.0",
      "dependencies": {
        "@retroroms/catalog": "0.1.0",
        "@retroroms/core": "0.1.0"
      }
    },
    "packages/ui": {
      "name": "@retroroms/ui",
      "version": "0.1.0",
      "dependencies": {
        "@retroroms/catalog": "0.1.0",
        "@retroroms/core": "0.1.0"
      }
    }
  }
}
